# MPCR EUROMAP 77 Collector settings. Copy to collector.env and fill in.
# Real environment variables with the same names win over this file.

# ---------- FANUC OPC UA gateway ----------
OPCUA_URL=opc.tcp://10.245.251.10:62553
OPCUA_USER=EUROMAP77_admin
OPCUA_PASSWORD=
# Basic256Sha256 (Sign & Encrypt, as the gateway requires) or None (test server only)
OPCUA_SECURITY=Basic256Sha256
# The client certificate the gateway trusts, relative to this folder or absolute
OPCUA_CERT=certs/rconnect_cert.der
OPCUA_KEY=certs/rconnect_key.pem
# Must match the application URI inside that certificate
OPCUA_APP_URI=urn:fanuc:euromap77:rconnect
OPCUA_NAMESPACE=6
OPCUA_MACHINE_PREFIX=IMM_FANUC_ROBOSHOT
# Machine numbers (IMM_FANUC_ROBOSHOT0001 …); same list as the plant collector
OPCUA_MACHINES=1-131
OPCUA_MACHINES_EXCLUDE=37,38,42,58,61,62,63,67,79,87,92,94,97,98
OPCUA_MACHINES_PER_SESSION=30
OPCUA_SAMPLING_MS=250
# 1 = also collect the per-shot ROBOSHOTCycleParametersEvent (cushion, injection time, pressure, temperatures)
OPCUA_CYCLE_EVENTS=1
OPCUA_BARREL_ZONES=6
OPCUA_MOULD_ZONES=4
OPCUA_RECONNECT_HOURS=2
OPCUA_RETRY_SECONDS=20

# ---------- MQTT ----------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
# Its own topic, so the other software reading factory/euromap77/raw is not affected
MQTT_TOPIC=mpcr/euromap77/mpcr
MQTT_QOS=0
MQTT_QUEUE=20000

# ---------- Publishing ----------
# At most one message per machine per interval; every live machine is resent at least every keepalive
COLLECTOR_PUBLISH_MS=1000
COLLECTOR_KEEPALIVE_SECONDS=60
