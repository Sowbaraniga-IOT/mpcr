# Production settings. Copy to backend/.env on the server (or to .env.production and set
# DJANGO_ENV_FILE=.env.production), fill in every value, then run:
#   .venv\Scripts\python manage.py check --deploy      → must report no issues
DJANGO_DEBUG=0
# 50+ random characters, unique per server, never committed:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# The names / addresses users type in the browser
DJANGO_ALLOWED_HOSTS=mpcr.plant01.local
# Served over https (TLS on this server or on IIS / nginx in front of it)
DJANGO_HTTPS=1
# 1 when IIS / nginx terminates TLS and forwards X-Forwarded-Proto
DJANGO_BEHIND_PROXY=1
# Start with 3600 on a new host; raise to 31536000 (1 year) once https is confirmed working
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_HSTS_PRELOAD=1
# Frontend origin(s) if the React build is served from another host
CORS_ALLOWED_ORIGINS=https://mpcr.plant01.local
DB_ENGINE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mpcr_db
DB_USER=mpcr_user
DB_PASSWORD=
TIME_ZONE=Asia/Kolkata
# EUROMAP 77 collector feed (manage.py euromap_bridge). HOST = the PC running Mosquitto and the collector
# (localhost when it is this PC); TOPIC must equal MQTT_TOPIC in collector/collector.env
FANUC_MQTT_HOST=localhost
FANUC_MQTT_PORT=1883
FANUC_MQTT_TOPIC=mpcr/euromap77/mpcr
# FANUC_MQTT_USER=
# FANUC_MQTT_PASSWORD=
# Only for names that differ from the MPCR id by more than punctuation, e.g. J1030=J10-30
# FANUC_MACHINE_MAP=
