# Development settings. Copy to backend/.env (npm run backend:setup does it).
# For a server, start from .env.production.example instead.
DJANGO_DEBUG=1
# Optional in development; required as soon as DJANGO_DEBUG=0.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_HTTPS=0
# sqlite (default, file backend/db.sqlite3) or postgres (docker compose up -d mpcr-postgres)
DB_ENGINE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mpcr_db
DB_USER=mpcr_user
DB_PASSWORD=mpcr_secure_pass_2026!
# Plant clock: production day starts 06:00 local time
TIME_ZONE=Asia/Kolkata
# EUROMAP 77 collector feed (manage.py euromap_bridge): the broker the OPC UA collector publishes to
FANUC_MQTT_HOST=localhost
FANUC_MQTT_PORT=1883
# mpcr/euromap77/mpcr = MPCR EUROMAP 77 Collector (../collector); factory/euromap77/raw = the plant's existing collector
FANUC_MQTT_TOPIC=mpcr/euromap77/mpcr
FANUC_MQTT_USER=
FANUC_MQTT_PASSWORD=
# Only for names that differ from the MPCR id by more than punctuation, e.g. J1030=J10-30
FANUC_MACHINE_MAP=
