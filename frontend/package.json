{
  "name": "mpcr-login",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "services": "start \"MPCR backend\" cmd /k npm run backend && npm run dev",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:setup": "powershell -ExecutionPolicy Bypass -File ../database/setup-db.ps1",
    "db:seed": "node ../database/generate-seed.mjs",
    "docker:db": "docker compose -f ../docker-compose.yml up -d mpcr-postgres",
    "backend": "cd ../backend && .venv\\Scripts\\python manage.py runserver 127.0.0.1:8000",
    "backend:setup": "cd ../backend && (if not exist .env copy .env.example .env) && py -m venv .venv && .venv\\Scripts\\python -m pip install -r requirements.txt && .venv\\Scripts\\python manage.py migrate && .venv\\Scripts\\python manage.py seed",
    "backend:simulate": "cd ../backend && .venv\\Scripts\\python manage.py simulate",
    "backend:test": "cd ../backend && .venv\\Scripts\\python manage.py test plant",
    "qa:e2e": "node ../qa/e2e/run.mjs",
    "qa:responsive": "node ../qa/responsive/audit.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5"
  }
}
